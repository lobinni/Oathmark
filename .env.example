# OPTIONAL local override only. The finalized Studionet contract address is
# already committed in code (src/lib/contract/address.ts), so a plain clone,
# GitHub push, or Vercel deploy needs no environment variables at all.
# To rotate deployments, prefer: node scripts/update-contract-address.mjs 0x…
NEXT_PUBLIC_OATHMARK_CONTRACT_ADDRESS=

# OPTIONAL: only for the live write samples in scripts/live/02-pledge.ts.
# Fund the derived account from the GenLayer Studio Accounts panel.
# Never commit a real key anywhere.
OATHMARK_SAMPLE_PRIVATE_KEY=
